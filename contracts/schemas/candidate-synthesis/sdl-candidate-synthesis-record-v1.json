      "title": "Input Digest",
      "type": "string"
    },
    "input_id": {
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Input Id",
      "type": "string"
    },
    "profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/CandidateSynthesisProfileDefinitionModel"
