{
  "$defs": {
    "ArtifactTransformationCheckModel": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Check Id",
          "type": "string"
        },
        "diagnostic_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Diagnostic Codes",
          "type": "array"
        },
        "outcome": {
          "$ref": "#/$defs/TransformationCheckOutcome"
        }
      },
      "required": [
        "check_id",
        "outcome"
      ],
      "title": "ArtifactTransformationCheckModel",
      "type": "object"
    },
    "ArtifactTransformationIdentityMapModel": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "minLength": 1,
          "title": "After",
          "type": "string"
        },
        "before": {
          "minLength": 1,
          "title": "Before",
          "type": "string"
        },
        "declaration_kind": {
          "minLength": 1,
          "title": "Declaration Kind",
          "type": "string"
        }
      },
      "required": [
        "declaration_kind",
        "before",
        "after"
      ],
      "title": "ArtifactTransformationIdentityMapModel",
      "type": "object"
    },
    "ArtifactTransformationKind": {
      "enum": [
        "sdl-authoring",
        "sdl-materialization",
        "portable-contract"
      ],
      "title": "ArtifactTransformationKind",
      "type": "string"
    },
    "ArtifactTransformationLossKind": {
      "enum": [
        "declaration-removed",
        "semantic-omission"
      ],
      "title": "ArtifactTransformationLossKind",
      "type": "string"
    },
    "ArtifactTransformationLossModel": {
      "additionalProperties": false,
      "properties": {
        "affected_identity": {
          "minLength": 1,
          "title": "Affected Identity",
          "type": "string"
        },
        "diagnostic": {
          "$ref": "#/$defs/DiagnosticModel"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactTransformationLossKind"
        }
      },
      "required": [
        "kind",
        "affected_identity",
        "diagnostic"
      ],
      "title": "ArtifactTransformationLossModel",
      "type": "object"
    },
    "ArtifactTransformationPreservationModel": {
      "additionalProperties": false,
      "properties": {
        "evidence_digests": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "^(?:sha256:[A-Fa-f0-9]{64}|sha384:[A-Fa-f0-9]{96}|sha512:[A-Fa-f0-9]{128}|blake3:[A-Fa-f0-9]{64})$",
            "type": "string"
          },
          "title": "Evidence Digests",
          "type": "array"
        },
        "limitations": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "outcome": {
          "$ref": "#/$defs/PreservationOutcome"
        },
        "profile": {
          "minLength": 1,
          "title": "Profile",
          "type": "string"
        }
      },
      "required": [
        "profile",
        "outcome"
      ],
      "title": "ArtifactTransformationPreservationModel",
      "type": "object"
    },
    "ArtifactTransformationReportModel": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "success"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "target_digest": {
                "type": "string"
              }
            },
            "required": [
              "target_digest"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "refused"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "diagnostics": {
                "minItems": 1
              },
              "target_digest": {
                "type": "null"
              }
            }
          }
        }
      ],
      "description": "Deterministic all-or-none report for one semantic operation.",
      "properties": {
        "affected_identities": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Affected Identities",
          "type": "array"
        },
        "artifact_kind": {
          "$ref": "#/$defs/ArtifactTransformationKind"
        },
        "canonicalization_profile": {
          "minLength": 1,
          "title": "Canonicalization Profile",
          "type": "string"
        },
        "derivation_digest": {
          "minLength": 1,
          "pattern": "^(?:sha256:[A-Fa-f0-9]{64}|sha384:[A-Fa-f0-9]{96}|sha512:[A-Fa-f0-9]{128}|blake3:[A-Fa-f0-9]{64})$",
          "title": "Derivation Digest",
          "type": "string"
        },
        "diagnostics": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DiagnosticModel"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "identity_map": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactTransformationIdentityMapModel"
          },
          "title": "Identity Map",
          "type": "array"
        },
        "losses": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactTransformationLossModel"
          },
          "title": "Losses",
          "type": "array"
        },
        "operation_profile": {
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/v[1-9][0-9]*$",
          "title": "Operation Profile",
          "type": "string"
        },
        "policy_digest": {
          "minLength": 1,
          "pattern": "^(?:sha256:[A-Fa-f0-9]{64}|sha384:[A-Fa-f0-9]{96}|sha512:[A-Fa-f0-9]{128}|blake3:[A-Fa-f0-9]{64})$",
          "title": "Policy Digest",
          "type": "string"
        },
        "postconditions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactTransformationCheckModel"
          },
          "title": "Postconditions",
          "type": "array"
        },
        "preconditions": {
          "items": {
            "$ref": "#/$defs/ArtifactTransformationCheckModel"
          },
          "minItems": 1,
          "title": "Preconditions",
          "type": "array"
        },
        "preservation": {
          "$ref": "#/$defs/ArtifactTransformationPreservationModel"
        },
        "schema_version": {
          "const": "artifact-transformation-report/v1",
          "default": "artifact-transformation-report/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_digest": {
          "minLength": 1,
          "pattern": "^(?:sha256:[A-Fa-f0-9]{64}|sha384:[A-Fa-f0-9]{96}|sha512:[A-Fa-f0-9]{128}|blake3:[A-Fa-f0-9]{64})$",
          "title": "Source Digest",
          "type": "string"
        },
        "source_profile": {
          "minLength": 1,
          "title": "Source Profile",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ArtifactTransformationStatus"
        },
        "target_digest": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^(?:sha256:[A-Fa-f0-9]{64}|sha384:[A-Fa-f0-9]{96}|sha512:[A-Fa-f0-9]{128}|blake3:[A-Fa-f0-9]{64})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Digest"
        },
        "target_profile": {
          "minLength": 1,
          "title": "Target Profile",
          "type": "string"
        }
      },
      "required": [
        "operation_profile",
        "status",
        "artifact_kind",
        "source_profile",
        "target_profile",
        "canonicalization_profile",
        "source_digest",
        "policy_digest",
        "derivation_digest",
        "preconditions",
        "preservation"
      ],
      "title": "RAES Artifact Transformation Report v1",
      "type": "object",
      "x-raes-invariants": [
        {
          "description": "Success carries a complete target digest; refusal carries no target and at least one bounded diagnostic.",
          "id": "artifact-transformation-all-or-none",
          "inputs": [
            {
              "contract_id": "artifact-transformation-report-v1",
              "instance_path": "#"
            }
          ],
          "level": "error",
          "validator": "raes_contracts.contracts.ArtifactTransformationReportModel.model_validate"
        },
        {
          "description": "Checks, identities, mappings, losses, diagnostics, and evidence use stable closed ordering.",
          "id": "artifact-transformation-deterministic-order",
          "inputs": [
            {
              "contract_id": "artifact-transformation-report-v1",
              "instance_path": "#"
            }
          ],
          "level": "error",
          "validator": "raes_contracts.contracts.ArtifactTransformationReportModel.model_validate"
        }
      ]
    },
    "ArtifactTransformationStatus": {
      "enum": [
        "success",
        "refused"
      ],
      "title": "ArtifactTransformationStatus",
      "type": "string"
    },
    "CandidateSynthesisAssumptionModel": {
      "additionalProperties": false,
      "properties": {
        "assertion_ids": {
          "items": {
            "maxLength": 128,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Assertion Ids",
          "type": "array"
        },
        "assumption_id": {
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Assumption Id",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "assumption_id",
        "assertion_ids",
        "statement"
      ],
      "title": "CandidateSynthesisAssumptionModel",
      "type": "object"
    },
    "CandidateSynthesisChoiceModel": {
      "additionalProperties": false,
      "properties": {
        "alternatives": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Alternatives",
          "type": "array"
        },
        "assertion_ids": {
          "items": {
            "maxLength": 128,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Assertion Ids",
          "type": "array"
        },
        "choice_id": {
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Choice Id",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/CandidateSynthesisReason"
        }
      },
      "required": [
        "choice_id",
        "reason",
        "assertion_ids"
      ],
      "title": "CandidateSynthesisChoiceModel",
      "type": "object"
    },
    "CandidateSynthesisConstructTraceModel": {
      "additionalProperties": false,
      "properties": {
        "contributions": {
          "items": {
            "$ref": "#/$defs/CandidateSynthesisContributionModel"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Contributions",
          "type": "array"
        },
        "target_ref": {
          "maxLength": 128,
          "pattern": "^nodes\\.[a-z][a-z0-9-]*$",
          "title": "Target Ref",
          "type": "string"
        }
      },
      "required": [
        "target_ref",
        "contributions"
      ],
      "title": "CandidateSynthesisConstructTraceModel",
      "type": "object"
    },
    "CandidateSynthesisContributionModel": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/SynthesisContributionKind"
        },
        "ref_id": {
          "minLength": 1,
          "title": "Ref Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref_id"
      ],
      "title": "CandidateSynthesisContributionModel",
      "type": "object"
    },
    "CandidateSynthesisDecisionModel": {
      "additionalProperties": false,
      "properties": {
        "actor_kind": {
          "enum": [
            "author",
            "governed-policy"
          ],
          "title": "Actor Kind",
          "type": "string"
        },
        "actor_ref": {
          "minLength": 1,
          "title": "Actor Ref",
          "type": "string"
        },
        "assertion_ids": {
          "items": {
            "maxLength": 128,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Assertion Ids",
          "type": "array"
        },
        "basis": {
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "decision_id": {
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Decision Id",
          "type": "string"
        },
        "node_type": {
          "enum": [
            "compute",
            "switch"
          ],
          "title": "Node Type",
          "type": "string"
        },
        "target_ref": {
          "maxLength": 128,
          "pattern": "^nodes\\.[a-z][a-z0-9-]*$",
          "title": "Target Ref",
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "actor_kind",
        "actor_ref",
        "assertion_ids",
        "target_ref",
        "node_type",
        "basis"
      ],
      "title": "CandidateSynthesisDecisionModel",
      "type": "object"
    },
    "CandidateSynthesisDisposition": {
      "enum": [
        "success",
        "requires-decision",
        "unsupported",
        "stale",
        "non-reproducible"
      ],
      "title": "CandidateSynthesisDisposition",
      "type": "string"
    },
    "CandidateSynthesisInputModel": {
      "additionalProperties": false,
      "description": "Bounded, source-neutral input to one trusted synthesis profile.",
      "properties": {
        "assertions": {
          "items": {
            "discriminator": {
              "mapping": {
                "concept": "#/$defs/ConceptSourceAssertionModel",
                "example": "#/$defs/ExampleSourceAssertionModel",
                "ordering": "#/$defs/OrderingSourceAssertionModel",
                "parameterization": "#/$defs/ParameterizationSourceAssertionModel",
                "precondition": "#/$defs/PreconditionSourceAssertionModel",
                "relationship": "#/$defs/RelationshipSourceAssertionModel"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ConceptSourceAssertionModel"
              },
              {
                "$ref": "#/$defs/RelationshipSourceAssertionModel"
              },
              {
                "$ref": "#/$defs/PreconditionSourceAssertionModel"
              },
              {
                "$ref": "#/$defs/OrderingSourceAssertionModel"
              },
              {
                "$ref": "#/$defs/ParameterizationSourceAssertionModel"
              },
              {
                "$ref": "#/$defs/ExampleSourceAssertionModel"
              }
            ]
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "Assertions",
          "type": "array"
        },
        "assumptions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CandidateSynthesisAssumptionModel"
          },
          "maxItems": 1024,
          "title": "Assumptions",
          "type": "array"
        },
        "decisions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CandidateSynthesisDecisionModel"
          },
          "maxItems": 1024,
          "title": "Decisions",
          "type": "array"
        },
        "input_id": {
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Input Id",
          "type": "string"
        },
        "input_version": {
          "minLength": 1,
          "title": "Input Version",
          "type": "string"
        },
        "policy_digest": {
          "minLength": 1,
          "pattern": "^(?:sha256:[A-Fa-f0-9]{64}|sha384:[A-Fa-f0-9]{96}|sha512:[A-Fa-f0-9]{128}|blake3:[A-Fa-f0-9]{64})$",
          "title": "Policy Digest",
          "type": "string"
        },
        "schema_version": {
          "const": "sdl-candidate-synthesis-input/v1",
          "default": "sdl-candidate-synthesis-input/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/CandidateSynthesisSourceModel"
        },
        "target": {
          "$ref": "#/$defs/CandidateSynthesisTargetModel"
        },
        "transformation_profile": {
          "$ref": "#/$defs/CandidateSynthesisProfileCoordinateModel"
        }
      },
      "required": [
        "input_id",
        "input_version",
        "source",
        "assertions",
        "target",
        "transformation_profile",
        "policy_digest"
      ],
      "title": "CandidateSynthesisInputModel",
      "type": "object",
      "x-raes-invariants": [
        {
          "description": "Every assertion and reference resolves inside one digest-pinned source envelope and assertion set.",
          "id": "candidate-synthesis-pinned-source-join",
          "inputs": [
            {
              "contract_id": "sdl-candidate-synthesis-input-v1",
              "instance_path": "#"
            }
          ],
          "level": "error",
          "validator": "raes_contracts.contracts.CandidateSynthesisInputModel.model_validate"
        },
        {
          "description": "Assertions, assumptions, decisions, references, values, and target identities use stable unique ordering.",
          "id": "candidate-synthesis-stable-input-order",
          "inputs": [
            {
              "contract_id": "sdl-candidate-synthesis-input-v1",
              "instance_path": "#"
            }
          ],
          "level": "error",
          "validator": "raes_contracts.contracts.CandidateSynthesisInputModel.model_validate"
        }
      ]
    },
    "CandidateSynthesisProfileCoordinateModel": {
      "additionalProperties": false,
      "description": "Exact coordinate for a governed, caller-supplied profile artifact.",
      "properties": {
        "digest": {
          "minLength": 1,
          "pattern": "^(?:sha256:[A-Fa-f0-9]{64}|sha384:[A-Fa-f0-9]{96}|sha512:[A-Fa-f0-9]{128}|blake3:[A-Fa-f0-9]{64})$",
          "title": "Digest",
          "type": "string"
        },
        "profile_id": {
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/v[1-9][0-9]*$",
          "title": "Profile Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "version",
        "digest"
      ],
      "title": "CandidateSynthesisProfileCoordinateModel",
      "type": "object"
    },
    "CandidateSynthesisProfileDefinitionModel": {
      "additionalProperties": false,
      "description": "Canonical content that binds every output-affecting profile decision.",
      "properties": {
        "all_or_none": {
          "const": true,
          "default": true,
          "title": "All Or None",
          "type": "boolean"
        },
        "canonicalization_profile": {
          "const": "raes-sdl-canonical/v1",
          "default": "raes-sdl-canonical/v1",
          "title": "Canonicalization Profile",
          "type": "string"
        },
        "default_ids": {
          "default": [],
          "items": {
            "maxLength": 128,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Default Ids",
          "type": "array"
        },
        "deterministic_order": {
          "const": "sorted-target-ref/v1",
          "default": "sorted-target-ref/v1",
          "title": "Deterministic Order",
          "type": "string"
        },
        "imports_allowed": {
          "const": false,
          "default": false,
          "title": "Imports Allowed",
          "type": "boolean"
        },
        "limits": {
          "$ref": "#/$defs/CandidateSynthesisProfileLimitsModel",
          "default": {
            "max_assertions": 4096,
            "max_assumptions": 1024,
            "max_decisions": 1024,
            "max_node_identifier_length": 35
          }
        },
        "profile_digest": {
          "minLength": 1,
          "pattern": "^(?:sha256:[A-Fa-f0-9]{64}|sha384:[A-Fa-f0-9]{96}|sha512:[A-Fa-f0-9]{128}|blake3:[A-Fa-f0-9]{64})$",
          "title": "Profile Digest",
          "type": "string"
        },
        "profile_id": {
          "const": "concept-nodes/v1",
          "default": "concept-nodes/v1",
          "title": "Profile Id",
          "type": "string"
        },
        "profile_version": {
          "const": "1",
          "default": "1",
          "title": "Profile Version",
          "type": "string"
        },
        "refusal_reason_codes": {
          "default": [
            "ambiguous-ordering",
            "missing-native-semantics",
            "stale-input",
            "transformation-profile-unavailable",
            "unresolved-parameterization",
            "unsupported-relation"
          ],
          "items": {
            "enum": [
              "ambiguous-ordering",
              "missing-native-semantics",
              "stale-input",
              "transformation-profile-unavailable",
              "unresolved-parameterization",
              "unsupported-relation"
            ],
            "type": "string"
          },
          "title": "Refusal Reason Codes",
          "type": "array"
        },
        "rendering_profile": {
          "const": "sdl-yaml/v1",
          "default": "sdl-yaml/v1",
          "title": "Rendering Profile",
          "type": "string"
        },
        "rule_ids": {
          "default": [
            "concept-node-emission"
          ],
          "items": {
            "maxLength": 128,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Rule Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "sdl-candidate-synthesis-profile/v1",
          "default": "sdl-candidate-synthesis-profile/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic_validation_required": {
          "const": true,
          "default": true,
          "title": "Semantic Validation Required",
          "type": "boolean"
        },
        "source_profile": {
          "const": "sdl-candidate-synthesis-input/v1",
          "default": "sdl-candidate-synthesis-input/v1",
          "title": "Source Profile",
          "type": "string"
        },
        "supported_assertion_kinds": {
          "default": [
            "concept"
          ],
          "items": {
            "const": "concept",
            "type": "string"
          },
          "title": "Supported Assertion Kinds",
          "type": "array"
        },
        "supported_node_types": {
          "default": [
            "compute",
            "switch"
          ],
          "items": {
            "enum": [
              "compute",
              "switch"
            ],
            "type": "string"
          },
          "title": "Supported Node Types",
          "type": "array"
        },
        "target_profile": {
