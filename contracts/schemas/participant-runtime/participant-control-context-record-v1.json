{
  "$defs": {
    "ParticipantControlContextAssetReferenceModel": {
      "additionalProperties": false,
      "properties": {
        "asset_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Asset Digest",
          "type": "string"
        },
        "asset_id": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "asset_version": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Asset Version",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "asset_version",
        "asset_digest"
      ],
      "title": "ParticipantControlContextAssetReferenceModel",
      "type": "object"
    },
    "ParticipantDecisionSurfaceCausalCutModel": {
      "additionalProperties": false,
      "description": "A downward-closed causal frontier for a partially ordered realization.",
      "properties": {
        "cut_kind": {
          "const": "causal_frontier",
          "title": "Cut Kind",
          "type": "string"
        },
        "cut_ref": {
          "minLength": 1,
          "title": "Cut Ref",
          "type": "string"
        },
        "frontier_event_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Frontier Event Refs",
          "type": "array"
        },
        "history_domain": {
          "minLength": 1,
          "title": "History Domain",
          "type": "string"
        },
        "order_model": {
          "const": "causal_partial_order",
          "title": "Order Model",
          "type": "string"
        },
        "predecessor_closure_ref": {
          "minLength": 1,
          "title": "Predecessor Closure Ref",
          "type": "string"
        }
      },
      "required": [
        "cut_kind",
        "cut_ref",
        "history_domain",
        "order_model",
        "frontier_event_refs",
        "predecessor_closure_ref"
      ],
      "title": "ParticipantDecisionSurfaceCausalCutModel",
      "type": "object"
    },
    "ParticipantDecisionSurfaceSequenceCutModel": {
      "additionalProperties": false,
      "description": "A complete prefix ending at one event in a declared total order.",
      "properties": {
        "anchor_event_ref": {
          "minLength": 1,
          "title": "Anchor Event Ref",
          "type": "string"
        },
        "anchor_order": {
          "minimum": 0,
          "title": "Anchor Order",
          "type": "integer"
        },
        "cut_kind": {
          "const": "sequence_prefix",
          "title": "Cut Kind",
          "type": "string"
        },
        "cut_ref": {
          "minLength": 1,
          "title": "Cut Ref",
          "type": "string"
        },
        "history_domain": {
          "enum": [
            "participant_episode_lifecycle",
            "participant_behavior_history"
          ],
          "title": "History Domain",
          "type": "string"
        },
        "history_prefix_length": {
          "minimum": 1,
          "title": "History Prefix Length",
          "type": "integer"
        },
        "order_model": {
          "enum": [
            "control_plane_order",
            "backend_serialized_order",
            "behavior_history_order"
          ],
          "title": "Order Model",
          "type": "string"
        },
        "predecessor_event_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Predecessor Event Refs",
          "type": "array"
        }
      },
      "required": [
        "cut_kind",
        "cut_ref",
        "history_domain",
        "order_model",
        "anchor_event_ref",
        "anchor_order",
        "history_prefix_length"
      ],
      "title": "ParticipantDecisionSurfaceSequenceCutModel",
      "type": "object"
    }
  },
  "$id": "https://openrae.github.io/rae/schemas/participant-control-context-record-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "selected"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "delivery_ref": {
            "type": "null"
          },
          "item_ref": {
            "type": "null"
          },
          "surface_id": {
            "type": "null"
          },
          "withholding_authority_ref": {
            "type": "null"
          }
        },
        "required": []
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "withheld"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "delivery_ref": {
            "type": "null"
          },
          "item_ref": {
            "type": "null"
          },
          "surface_id": {
            "type": "null"
          },
          "withholding_authority_ref": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "withholding_authority_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "disclosed"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "delivery_ref": {
            "type": "null"
          },
          "item_ref": {
            "not": {
              "type": "null"
            }
          },
          "surface_id": {
            "not": {
              "type": "null"
            }
          },
          "withholding_authority_ref": {
            "type": "null"
          }
        },
        "required": [
          "item_ref",
          "surface_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "delivered"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "delivery_ref": {
            "not": {
              "type": "null"
            }
          },
          "item_ref": {
            "not": {
              "type": "null"
            }
          },
          "surface_id": {
            "not": {
              "type": "null"
            }
          },
          "withholding_authority_ref": {
            "type": "null"
          }
        },
        "required": [
          "delivery_ref",
          "item_ref",
          "surface_id"
        ]
      }
    }
  ],
  "description": "One version selection, with disclosure and actual delivery kept separate.",
  "properties": {
    "asset_ref": {
      "$ref": "#/$defs/ParticipantControlContextAssetReferenceModel"
    },
    "audience_scope_ref": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Audience Scope Ref",
      "type": "string"
    },
    "delivery_ref": {
      "anyOf": [
        {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Delivery Ref"
    },
    "disposition": {
      "enum": [
        "selected",
        "withheld",
        "disclosed",
        "delivered"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "episode_generation": {
      "minimum": 0,
      "title": "Episode Generation",
      "type": "integer"
    },
    "episode_id": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Episode Id",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "maxLength": 1024,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array",
      "uniqueItems": true
    },
    "item_ref": {
      "anyOf": [
        {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Item Ref"
    },
    "participant_address": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Participant Address",
      "type": "string"
    },
    "provenance_refs": {
      "items": {
        "maxLength": 1024,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Provenance Refs",
      "type": "array",
      "uniqueItems": true
    },
    "record_cut": {
      "discriminator": {
        "mapping": {
          "causal_frontier": "#/$defs/ParticipantDecisionSurfaceCausalCutModel",
          "sequence_prefix": "#/$defs/ParticipantDecisionSurfaceSequenceCutModel"
        },
        "propertyName": "cut_kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ParticipantDecisionSurfaceSequenceCutModel"
        },
        {
          "$ref": "#/$defs/ParticipantDecisionSurfaceCausalCutModel"
        }
      ],
      "title": "Record Cut"
    },
    "record_id": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Record Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "participant-control-context-record/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_ref": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Scope Ref",
      "type": "string"
    },
    "selected_by_ref": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Selected By Ref",
      "type": "string"
    },
    "selection_authority_ref": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Selection Authority Ref",
      "type": "string"
    },
    "selection_cut": {
      "discriminator": {
        "mapping": {
          "causal_frontier": "#/$defs/ParticipantDecisionSurfaceCausalCutModel",
          "sequence_prefix": "#/$defs/ParticipantDecisionSurfaceSequenceCutModel"
        },
        "propertyName": "cut_kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ParticipantDecisionSurfaceSequenceCutModel"
        },
        {
          "$ref": "#/$defs/ParticipantDecisionSurfaceCausalCutModel"
        }
      ],
      "title": "Selection Cut"
    },
    "selection_ref": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Selection Ref",
      "type": "string"
    },
    "surface_id": {
      "anyOf": [
        {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Surface Id"
    },
    "withholding_authority_ref": {
      "anyOf": [
        {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Withholding Authority Ref"
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "selection_ref",
    "scope_ref",
    "run_id",
    "participant_address",
    "episode_id",
    "episode_generation",
    "audience_scope_ref",
    "asset_ref",
    "selected_by_ref",
    "selection_authority_ref",
    "selection_cut",
    "record_cut",
    "disposition",
    "evidence_refs",
    "provenance_refs"
  ],
  "title": "ParticipantControlContextRecordModel",
  "type": "object",
  "x-raes-invariants": [
    {
      "description": "Full conformance requires trusted exact version, lifecycle, authority, recipient, cut and content agreement.",
      "id": "control-context-trusted-agreement",
      "inputs": [
        {
          "contract_id": "participant-control-context-record-v1",
          "instance_path": "#"
        }
      ],
      "level": "error"
    }
  ],
  "x-raes-semantic-profile": {
    "contract_id": "participant-control-context-record-v1",
    "entry_schema_contract_id": "raes-semantic-invariants-v1",
    "entry_schema_pointer": "#/$defs/RaesSemanticInvariantEntryModel",
    "id": "raes-semantic-invariants-v1",
    "keyword": "x-raes-invariants",
    "required": true,
    "uri": "https://openrae.github.io/rae/schemas/semantic-invariants/v1"
  }
}
