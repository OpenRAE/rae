          "title": "Description",
          "type": "string"
        },
        "destination_path": {
          "default": "",
          "title": "Destination Path",
          "type": "string"
        },
        "identifier": {
          "title": "Identifier",
          "type": "string"
        },
        "source_path": {
          "default": "",
          "title": "Source Path",
          "type": "string"
        }
