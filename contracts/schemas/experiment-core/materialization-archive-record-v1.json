{
  "$defs": {
    "ExperimentArtifactRefModel": {
      "additionalProperties": false,
      "description": "Reference to an artifact that supports a task, run, apparatus, or study.",
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "checksum": {
          "$ref": "#/$defs/ExperimentChecksumModel"
        },
        "created_at": {
          "format": "date-time",
          "minLength": 1,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt](?:[01]\\d|2[0-3]):[0-5]\\d:(?:[0-5]\\d|60)(?:\\.\\d+)?(?:[Zz]|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
          "title": "Created At",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "role": {
          "enum": [
            "protocol",
            "metric-definition",
            "scenario-snapshot",
            "materialization-attestation",
            "manifest",
            "apparatus-evidence",
            "observation",
            "result",
            "analysis",
            "report",
            "export",
            "starter-file",
            "evaluator",
            "subtask",
            "gold-step",
            "milestone",
            "human-assistance",
            "scaffold",
            "baseline",
            "cost-resource-trace",
            "documentation",
            "operator-guide",
            "configuration",
            "profile",
            "dataset",
            "other"
          ],
          "title": "Role",
          "type": "string"
        },
        "satisfies_refs": {
          "items": {
            "$ref": "#/$defs/ExperimentEvidenceSatisfactionReferenceModel"
          },
          "title": "Satisfies Refs",
          "type": "array"
        },
        "sensitivity": {
          "enum": [
            "public",
            "internal",
            "restricted",
            "redacted"
          ],
          "title": "Sensitivity",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "role",
        "media_type",
        "uri",
        "checksum",
        "size_bytes",
        "created_at",
        "source",
        "sensitivity"
      ],
      "title": "ExperimentArtifactRefModel",
      "type": "object"
    },
    "ExperimentChecksumModel": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "sha256"
              }
            },
            "required": [
              "algorithm"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[A-Fa-f0-9]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "sha384"
              }
            },
            "required": [
              "algorithm"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[A-Fa-f0-9]{96}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "sha512"
              }
            },
            "required": [
              "algorithm"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[A-Fa-f0-9]{128}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "blake3"
              }
            },
            "required": [
              "algorithm"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[A-Fa-f0-9]{64}$"
              }
            }
          }
        }
      ],
      "description": "Checksum metadata for an experiment-core artifact reference.",
      "properties": {
        "algorithm": {
          "enum": [
            "sha256",
            "sha384",
            "sha512",
            "blake3"
          ],
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "pattern": "^[A-Fa-f0-9]+$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "title": "ExperimentChecksumModel",
      "type": "object"
    },
    "ExperimentEvidenceSatisfactionReferenceModel": {
      "additionalProperties": false,
      "description": "Evidence concept reference that an artifact claims to satisfy.",
      "properties": {
        "ref_id": {
          "minLength": 1,
          "title": "Ref Id",
          "type": "string"
        },
        "ref_kind": {
          "const": "evidence",
          "title": "Ref Kind",
          "type": "string"
        },
        "ref_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref Version"
        }
      },
      "required": [
        "ref_kind",
        "ref_id"
      ],
      "title": "ExperimentEvidenceSatisfactionReferenceModel",
      "type": "object"
    },
    "MaterializationAttestationReferenceModel": {
      "additionalProperties": false,
      "description": "A descriptive artifact identity, never the original scenario snapshot.",
      "properties": {
        "ref_digest": {
          "minLength": 1,
          "pattern": "^(?:sha256:[A-Fa-f0-9]{64}|sha384:[A-Fa-f0-9]{96}|sha512:[A-Fa-f0-9]{128}|blake3:[A-Fa-f0-9]{64})$",
          "title": "Ref Digest",
          "type": "string"
        },
        "ref_id": {
          "minLength": 1,
          "title": "Ref Id",
          "type": "string"
        },
        "ref_kind": {
          "const": "materialization-attestation",
          "default": "materialization-attestation",
          "title": "Ref Kind",
          "type": "string"
        },
        "ref_path": {
          "minLength": 1,
          "title": "Ref Path",
          "type": "string"
        },
        "ref_version": {
          "const": "raes-sdl-materialized/v1",
          "default": "raes-sdl-materialized/v1",
          "title": "Ref Version",
          "type": "string"
        }
      },
      "required": [
        "ref_id",
        "ref_digest",
        "ref_path"
      ],
      "title": "MaterializationAttestationReferenceModel",
      "type": "object"
    },
    "RuntimeConcernSelection": {
      "additionalProperties": false,
      "description": "A choice claim naming an admitted concern, never a provenance ledger write.",
      "properties": {
        "address": {
          "maxLength": 2048,
          "minLength": 3,
          "not": {
            "pattern": "[^a-z0-9_.-]"
          },
          "pattern": "^(?:[a-z0-9][a-z0-9_-]{0,63}|__private)(?:\\.(?:[a-z0-9][a-z0-9_-]{0,63}|__private))+$",
          "title": "Address",
          "type": "string"
        },
        "field_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Field Path",
          "type": "string"
        },
        "requirement_kind": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Requirement Kind",
          "type": "string"
        }
      },
      "required": [
        "address",
        "field_path",
        "requirement_kind"
      ],
      "title": "RuntimeConcernSelection",
      "type": "object"
    },
    "RuntimeDescendantBinding": {
      "additionalProperties": false,
      "description": "Stable causal identity; topology and ownership remain separate facts.",
      "properties": {
        "address": {
          "maxLength": 2048,
          "minLength": 3,
          "not": {
            "pattern": "[^a-z0-9_.-]"
          },
          "pattern": "^(?:[a-z0-9][a-z0-9_-]{0,63}|__private)(?:\\.(?:[a-z0-9][a-z0-9_-]{0,63}|__private))+$",
          "title": "Address",
          "type": "string"
        },
        "creation": {
          "$ref": "#/$defs/RuntimeInventoryEvidence"
        },
        "lifecycle": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeInventoryEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "native_identity_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Native Identity Digest",
          "type": "string"
        },
        "parent_address": {
          "maxLength": 2048,
          "minLength": 3,
          "not": {
            "pattern": "[^a-z0-9_.-]"
          },
          "pattern": "^(?:[a-z0-9][a-z0-9_-]{0,63}|__private)(?:\\.(?:[a-z0-9][a-z0-9_-]{0,63}|__private))+$",
          "title": "Parent Address",
          "type": "string"
        },
        "parent_instance_index": {
          "default": 0,
          "minimum": 0,
          "title": "Parent Instance Index",
          "type": "integer"
        },
        "source_address": {
          "maxLength": 2048,
          "minLength": 3,
          "not": {
            "pattern": "[^a-z0-9_.-]"
          },
          "pattern": "^(?:[a-z0-9][a-z0-9_-]{0,63}|__private)(?:\\.(?:[a-z0-9][a-z0-9_-]{0,63}|__private))+$",
          "title": "Source Address",
          "type": "string"
        },
        "state": {
          "default": "active",
          "enum": [
            "active",
            "terminated",
            "autoremoved"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "address",
        "parent_address",
        "source_address",
        "native_identity_digest",
        "creation"
      ],
      "title": "RuntimeDescendantBinding",
      "type": "object"
    },
    "RuntimeInventoryEvidence": {
      "additionalProperties": false,
      "description": "Producer-scoped native receipt identity, not independent observation.",
      "properties": {
        "attempt_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Attempt Id",
          "type": "string"
        },
        "evidence_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Evidence Digest",
          "type": "string"
        },
        "operation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Operation Id",
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "operation_id",
        "attempt_id",
        "evidence_digest"
      ],
      "title": "RuntimeInventoryEvidence",
      "type": "object"
    },
    "RuntimeInventoryReport": {
      "additionalProperties": false,
      "description": "Complete bounded producer inventory, joined to the descriptive SDL bytes.",
      "properties": {
        "attempt_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Attempt Id",
          "type": "string"
        },
        "backend_selections": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RuntimeConcernSelection"
          },
          "maxItems": 4096,
          "title": "Backend Selections",
          "type": "array"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "contract_id": {
          "const": "backend-runtime-descendants-v1",
          "default": "backend-runtime-descendants-v1",
          "title": "Contract Id",
          "type": "string"
        },
        "descendants": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RuntimeDescendantBinding"
          },
          "maxItems": 4096,
          "title": "Descendants",
          "type": "array"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Run Id",
          "type": "string"
        },
        "scope": {
          "const": "/nodes",
          "default": "/nodes",
          "title": "Scope",
          "type": "string"
        },
        "sequence": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "source_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Source Digest",
          "type": "string"
        },
        "target_scope": {
          "maxLength": 256,
          "minLength": 8,
          "pattern": "^target:[^\\s\\x00-\\x1f]+$",
          "title": "Target Scope",
          "type": "string"
        },
        "unavailable_evidence": {
          "default": [],
          "items": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Unavailable Evidence",
          "type": "array"
        }
      },
      "required": [
        "attempt_id",
        "sequence",
        "complete",
        "source_digest",
        "run_id",
        "target_scope"
      ],
      "title": "RuntimeInventoryReport",
      "type": "object"
    }
  },
  "$id": "https://openrae.github.io/rae/schemas/materialization-archive-record-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Published protected bytes and their distinct semantic identity.",
  "properties": {
    "artifact": {
      "$ref": "#/$defs/ExperimentArtifactRefModel"
    },
    "inventory": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuntimeInventoryReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "operation_id": {
      "minLength": 1,
      "title": "Operation Id",
      "type": "string"
    },
    "reference": {
      "$ref": "#/$defs/MaterializationAttestationReferenceModel"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "reference",
    "artifact",
    "run_id",
    "operation_id"
  ],
  "title": "MaterializationArchiveRecord",
  "type": "object",
  "x-raes-invariants": [
    {
      "description": "The typed record must join protected immutable published SDL bytes to their size, checksum, semantic identity, run and operation; metadata alone does not prove delivery.",
      "id": "materialization-archive-byte-and-lineage-binding",
      "inputs": [
        {
          "contract_id": "materialization-archive-record-v1",
          "instance_path": "#"
        }
      ],
      "level": "error",
      "validator": "raes_processor.planner.validate_materialization_archive_record"
    }
  ],
  "x-raes-semantic-profile": {
    "contract_id": "materialization-archive-record-v1",
    "entry_schema_contract_id": "raes-semantic-invariants-v1",
    "entry_schema_pointer": "#/$defs/RaesSemanticInvariantEntryModel",
    "id": "raes-semantic-invariants-v1",
    "keyword": "x-raes-invariants",
    "required": true,
    "uri": "https://openrae.github.io/rae/schemas/semantic-invariants/v1"
  }
}
