        "authorization_record_ref": {
          "minLength": 1,
          "title": "Authorization Record Ref",
          "type": "string"
        },
        "delivery_basis_ref": {
          "minLength": 1,
          "title": "Delivery Basis Ref",
          "type": "string"
        },
        "delivery_order": {
          "minimum": 0,
          "title": "Delivery Order",
          "type": "integer"
        },
        "evidence_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "item_ref": {
          "minLength": 1,
          "title": "Item Ref",
          "type": "string"
        },
        "limitations": {
          "items": {
            "minLength": 1,
            "type": "string"
