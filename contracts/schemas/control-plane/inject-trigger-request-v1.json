          "maxLength": 256,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "contract_id": {
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-v[0-9]+$",
          "title": "Contract Id",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "artifact_id",
        "digest"
      ],
      "title": "OperationArtifactReferenceModel",
      "type": "object"
    }
  },
