{
  "$defs": {
    "InjectEventPlacementModel": {
      "additionalProperties": false,
      "description": "Event-anchored request; the event's precondition assertions remain binding.",
      "properties": {
        "event": {
          "maxLength": 2048,
          "minLength": 3,
          "not": {
            "pattern": "[^a-z0-9_.-]"
          },
          "pattern": "^(?:[a-z0-9][a-z0-9_-]{0,63}|__private)(?:\\.(?:[a-z0-9][a-z0-9_-]{0,63}|__private))+$",
          "title": "Event",
          "type": "string"
        },
        "kind": {
          "const": "event",
          "default": "event",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "event"
      ],
      "title": "InjectEventPlacementModel",
      "type": "object"
    },
    "InjectIndependentPlacementModel": {
      "additionalProperties": false,
      "description": "Direct request through an admitted independent binding; no schedule is invented.",
      "properties": {
        "kind": {
          "const": "independent",
          "default": "independent",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "InjectIndependentPlacementModel",
      "type": "object"
    },
    "InjectSchedulePlacementModel": {
      "additionalProperties": false,
      "description": "One uniquely identified schedule slot, claimable at most once in its run.",
      "properties": {
        "event": {
          "maxLength": 2048,
          "minLength": 3,
          "not": {
            "pattern": "[^a-z0-9_.-]"
          },
          "pattern": "^(?:[a-z0-9][a-z0-9_-]{0,63}|__private)(?:\\.(?:[a-z0-9][a-z0-9_-]{0,63}|__private))+$",
          "title": "Event",
          "type": "string"
        },
        "kind": {
          "const": "schedule",
          "default": "schedule",
          "title": "Kind",
          "type": "string"
        },
        "script": {
          "maxLength": 2048,
          "minLength": 3,
          "not": {
            "pattern": "[^a-z0-9_.-]"
          },
          "pattern": "^(?:[a-z0-9][a-z0-9_-]{0,63}|__private)(?:\\.(?:[a-z0-9][a-z0-9_-]{0,63}|__private))+$",
          "title": "Script",
          "type": "string"
        },
        "slot": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Slot",
          "type": "string"
        },
        "story": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 3,
              "not": {
                "pattern": "[^a-z0-9_.-]"
              },
              "pattern": "^(?:[a-z0-9][a-z0-9_-]{0,63}|__private)(?:\\.(?:[a-z0-9][a-z0-9_-]{0,63}|__private))+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Story"
        }
      },
      "required": [
        "event",
        "script",
        "slot"
      ],
      "title": "InjectSchedulePlacementModel",
      "type": "object"
    },
    "InjectTargetBindingModel": {
      "additionalProperties": false,
      "description": "One selected realization instance of a compiled node binding; entity names never select hosts.",
      "properties": {
        "binding": {
          "maxLength": 2048,
          "minLength": 3,
          "not": {
            "pattern": "[^a-z0-9_.-]"
          },
          "pattern": "^(?:[a-z0-9][a-z0-9_-]{0,63}|__private)(?:\\.(?:[a-z0-9][a-z0-9_-]{0,63}|__private))+$",
          "title": "Binding",
          "type": "string"
        },
        "instance": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Instance",
          "type": "string"
        },
        "node": {
          "maxLength": 2048,
          "minLength": 3,
          "not": {
            "pattern": "[^a-z0-9_.-]"
          },
          "pattern": "^(?:[a-z0-9][a-z0-9_-]{0,63}|__private)(?:\\.(?:[a-z0-9][a-z0-9_-]{0,63}|__private))+$",
          "title": "Node",
          "type": "string"
        },
        "revision": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "binding",
        "node",
        "instance",
        "revision"
      ],
      "title": "InjectTargetBindingModel",
      "type": "object"
    },
    "OperationArtifactReferenceModel": {
      "additionalProperties": false,
      "description": "Content-bound reference resolved through the owning admitted artifact authority.",
