    "request_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Request Key",
      "type": "string"
    },
    "run_scope": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Run Scope",
      "type": "string"
    },
    "schema_version": {
      "const": "inject-trigger-request/v1",
      "default": "inject-trigger-request/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "target_scope": {
