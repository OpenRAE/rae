{
  "$defs": {
    "CleanStateClaimModel": {
      "additionalProperties": false,
      "description": "Evidence-bounded post-cleanup state disposition.",
      "properties": {
        "boundary_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Boundary Refs",
          "type": "array",
          "uniqueItems": true
        },
        "disposition": {
          "enum": [
            "verified-clean",
            "declared-reusable",
            "fresh-range-required"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "disposition",
        "boundary_refs",
        "evidence_refs"
      ],
      "title": "CleanStateClaimModel",
      "type": "object"
    },
    "CleanupObligationResultModel": {
      "additionalProperties": false,
      "description": "Attempt outcome for one declared cleanup obligation.",
      "properties": {
        "evidence_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array",
          "uniqueItems": true
        },
        "obligation_id": {
          "minLength": 1,
          "title": "Obligation Id",
          "type": "string"
        },
        "residual_state_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Residual State Refs",
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "skipped",
            "unsupported",
            "unverified",
            "not-triggered"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "obligation_id",
        "status"
      ],
      "title": "CleanupObligationResultModel",
      "type": "object"
    }
  },
  "$id": "https://openrae.github.io/rae/schemas/trial-cleanup-receipt-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "cleanup_status": {
            "not": {
              "const": "succeeded"
            }
          }
        },
        "required": [
          "cleanup_status"
        ]
      },
      "then": {
        "properties": {
          "clean_state_claim": {
            "type": "null"
          }
        }
      }
    }
  ],
  "description": "Immutable attempt receipt that reports cleanup separately from trial outcome.",
  "properties": {
    "clean_state_claim": {
      "anyOf": [
        {
          "$ref": "#/$defs/CleanStateClaimModel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cleanup_plan_ref": {
      "minLength": 1,
      "title": "Cleanup Plan Ref",
      "type": "string"
    },
    "cleanup_status": {
      "enum": [
        "succeeded",
        "failed",
        "partial",
        "unsupported",
        "unverified",
        "not-required"
      ],
      "title": "Cleanup Status",
      "type": "string"
    },
    "execution_attempt_id": {
      "minLength": 1,
      "title": "Execution Attempt Id",
      "type": "string"
    },
    "obligation_results": {
      "additionalProperties": {
        "$ref": "#/$defs/CleanupObligationResultModel"
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Obligation Results",
      "type": "object"
    },
    "plan_entry_id": {
      "minLength": 1,
      "title": "Plan Entry Id",
      "type": "string"
    },
    "receipt_id": {
      "minLength": 1,
      "title": "Receipt Id",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "trial-cleanup-receipt/v1",
      "default": "trial-cleanup-receipt/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "trial_outcome": {
      "enum": [
        "succeeded",
        "failed",
        "cancelled",
        "timed-out",
        "aborted"
      ],
      "title": "Trial Outcome",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "cleanup_plan_ref",
    "plan_entry_id",
    "run_id",
    "execution_attempt_id",
    "trial_outcome",
    "cleanup_status"
  ],
  "title": "TrialCleanupReceiptModel",
  "type": "object",
