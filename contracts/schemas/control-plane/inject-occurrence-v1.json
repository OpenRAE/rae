      "id": "inject-occurrence-local-consistency",
      "inputs": [
        {
          "contract_id": "inject-occurrence-v1",
          "instance_path": "#"
        }
      ],
      "level": "error",
      "validator": "raes_contracts.contracts.InjectOccurrenceModel.model_validate"
    },
    {
      "description": "Retry keys, occurrences, operations, schedule slots, order positions and order predecessors are each claimed at most once in one target/run store, so no two claims follow the same head; head tokens are opaque, so the head chain itself is not checked.",
      "id": "inject-occurrence-unique-claims",
      "inputs": [
        {
          "contract_id": "inject-occurrence-v1",
          "instance_path": "#"
        }
      ],
      "level": "error",
      "validator": "raes_contracts.contracts.validate_inject_occurrence_claims"
    }
  ],
  "x-raes-semantic-profile": {
    "contract_id": "inject-occurrence-v1",
    "entry_schema_contract_id": "raes-semantic-invariants-v1",
    "entry_schema_pointer": "#/$defs/RaesSemanticInvariantEntryModel",
    "id": "raes-semantic-invariants-v1",
    "keyword": "x-raes-invariants",
    "required": true,
    "uri": "https://openrae.github.io/rae/schemas/semantic-invariants/v1"
  }
}
