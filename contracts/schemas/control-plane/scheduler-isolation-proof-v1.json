{
  "$defs": {
    "IsolationDimensionEvidenceModel": {
      "additionalProperties": false,
      "description": "Evidence for one bounded-parallelism isolation dimension.",
      "properties": {
        "dimension": {
          "enum": [
            "range-instance",
            "host-capacity",
            "ports",
            "storage",
            "control-plane-locks",
            "secret-scope",
            "cleanup"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array",
          "uniqueItems": true
        },
        "independent": {
          "title": "Independent",
          "type": "boolean"
        }
      },
      "required": [
        "dimension",
        "independent",
        "evidence_refs"
      ],
      "title": "IsolationDimensionEvidenceModel",
      "type": "object"
    }
  },
  "$id": "https://openrae.github.io/rae/schemas/scheduler-isolation-proof-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "requested_parallelism": {
            "minimum": 2
          }
        },
        "required": [
          "requested_parallelism"
        ]
      },
      "then": {
        "properties": {
          "dimensions": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "dimension": {
                      "const": "cleanup"
                    },
                    "evidence_refs": {
                      "minItems": 1
                    },
                    "independent": {
                      "const": true
                    }
                  },
                  "required": [
                    "dimension",
                    "independent",
                    "evidence_refs"
                  ],
                  "type": "object"
                }
              },
              {
                "contains": {
                  "properties": {
                    "dimension": {
                      "const": "control-plane-locks"
                    },
                    "evidence_refs": {
                      "minItems": 1
                    },
                    "independent": {
                      "const": true
                    }
                  },
                  "required": [
                    "dimension",
                    "independent",
                    "evidence_refs"
                  ],
                  "type": "object"
                }
              },
              {
                "contains": {
                  "properties": {
                    "dimension": {
                      "const": "host-capacity"
                    },
                    "evidence_refs": {
                      "minItems": 1
                    },
                    "independent": {
                      "const": true
                    }
                  },
                  "required": [
                    "dimension",
                    "independent",
                    "evidence_refs"
                  ],
                  "type": "object"
                }
              },
              {
                "contains": {
                  "properties": {
                    "dimension": {
                      "const": "ports"
                    },
                    "evidence_refs": {
                      "minItems": 1
                    },
                    "independent": {
                      "const": true
                    }
                  },
                  "required": [
                    "dimension",
                    "independent",
                    "evidence_refs"
                  ],
                  "type": "object"
                }
              },
              {
                "contains": {
                  "properties": {
                    "dimension": {
                      "const": "range-instance"
                    },
                    "evidence_refs": {
                      "minItems": 1
                    },
                    "independent": {
                      "const": true
                    }
                  },
                  "required": [
                    "dimension",
                    "independent",
                    "evidence_refs"
                  ],
                  "type": "object"
                }
              },
              {
                "contains": {
                  "properties": {
                    "dimension": {
                      "const": "secret-scope"
                    },
                    "evidence_refs": {
                      "minItems": 1
                    },
                    "independent": {
                      "const": true
                    }
                  },
                  "required": [
                    "dimension",
                    "independent",
                    "evidence_refs"
                  ],
                  "type": "object"
                }
              },
              {
                "contains": {
                  "properties": {
                    "dimension": {
                      "const": "storage"
                    },
                    "evidence_refs": {
                      "minItems": 1
                    },
                    "independent": {
                      "const": true
                    }
                  },
                  "required": [
                    "dimension",
                    "independent",
                    "evidence_refs"
                  ],
                  "type": "object"
                }
              }
            ],
            "minItems": 7
          }
        }
      }
    }
  ],
  "description": "Schedule-independent proof permitting a bounded parallelism request.",
  "properties": {
    "dimensions": {
      "items": {
        "$ref": "#/$defs/IsolationDimensionEvidenceModel"
      },
      "title": "Dimensions",
      "type": "array"
    },
    "plan_entry_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Plan Entry Ids",
      "type": "array",
      "uniqueItems": true
    },
    "proof_id": {
      "minLength": 1,
      "title": "Proof Id",
      "type": "string"
    },
    "requested_parallelism": {
      "default": 1,
      "minimum": 1,
      "title": "Requested Parallelism",
      "type": "integer"
    },
    "schema_version": {
      "const": "scheduler-isolation-proof/v1",
      "default": "scheduler-isolation-proof/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "proof_id",
    "plan_entry_ids"
  ],
  "title": "SchedulerIsolationProofModel",
  "type": "object",
  "x-raes-invariants": [
    {
      "description": "Scheduling defaults to serial; bounded parallelism requires independent evidence for range, capacity, ports, storage, control-plane locks, secret scope, and cleanup.",
      "id": "scheduler-isolation-serial-default-and-complete-parallel-proof",
      "inputs": [
        {
          "contract_id": "scheduler-isolation-proof-v1",
          "instance_path": "#"
        }
      ],
      "level": "error"
    }
  ],
  "x-raes-semantic-profile": {
