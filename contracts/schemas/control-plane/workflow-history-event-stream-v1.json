{
  "$id": "https://openrae.github.io/rae/schemas/workflow-history-event-stream-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "items": {
    "additionalProperties": false,
    "properties": {
      "attempt": {
        "anyOf": [
          {
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Attempt"
      },
      "branch_name": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Branch Name"
      },
      "details": {
        "additionalProperties": true,
        "title": "Details",
        "type": "object"
      },
      "dispatch_id": {
        "anyOf": [
          {
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Dispatch Id"
      },
      "event_type": {
        "title": "Event Type",
        "type": "string"
      },
      "invocation_id": {
        "anyOf": [
          {
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Invocation Id"
      },
      "join_step": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Join Step"
      },
      "origin": {
        "anyOf": [
          {
            "enum": [
              "runtime",
              "backend"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Origin"
      },
      "outcome": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Outcome"
      },
      "step_name": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Step Name"
      },
      "timestamp": {
        "title": "Timestamp",
        "type": "string"
      }
    },
    "required": [
      "event_type",
      "timestamp"
    ],
    "title": "WorkflowHistoryEventModel",
    "type": "object"
  },
  "title": "WorkflowHistoryEventStream",
  "type": "array"
}
