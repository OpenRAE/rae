{
  "$defs": {
    "RaesSemanticInvariantEntryModel": {
      "additionalProperties": false,
      "description": "Machine-readable semantic invariant annotation entry.\n\nThe contract id of the host schema and the entry id identify the invariant.",
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/RaesSemanticInvariantInputModel"
          },
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "level": {
          "const": "error",
          "title": "Level",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description",
        "level",
        "inputs"
      ],
      "title": "RaesSemanticInvariantEntryModel",
      "type": "object"
    },
    "RaesSemanticInvariantInputModel": {
      "additionalProperties": false,
      "description": "Input contract and instance path required by one RAES semantic invariant.",
      "properties": {
        "contract_id": {
          "minLength": 1,
          "title": "Contract Id",
          "type": "string"
        },
        "instance_path": {
          "pattern": "^#(?:/[A-Za-z0-9_.$~-]+)*$",
          "title": "Instance Path",
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "instance_path"
      ],
      "title": "RaesSemanticInvariantInputModel",
      "type": "object"
    },
    "RaesSemanticInvariantProfileReferenceModel": {
      "additionalProperties": false,
      "description": "Host-schema reference to the RAES semantic-invariant profile.",
      "properties": {
        "contract_id": {
          "minLength": 1,
          "title": "Contract Id",
          "type": "string"
        },
        "entry_schema_contract_id": {
          "const": "raes-semantic-invariants-v1",
          "title": "Entry Schema Contract Id",
          "type": "string"
        },
        "entry_schema_pointer": {
          "const": "#/$defs/RaesSemanticInvariantEntryModel",
          "title": "Entry Schema Pointer",
          "type": "string"
        },
        "id": {
          "const": "raes-semantic-invariants-v1",
          "title": "Id",
          "type": "string"
        },
        "keyword": {
          "const": "x-raes-invariants",
          "title": "Keyword",
          "type": "string"
        },
        "required": {
          "const": true,
          "title": "Required",
          "type": "boolean"
        },
        "uri": {
          "const": "https://openrae.github.io/rae/schemas/semantic-invariants/v1",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "id",
        "uri",
        "contract_id",
        "keyword",
        "required",
        "entry_schema_contract_id",
        "entry_schema_pointer"
      ],
      "title": "RaesSemanticInvariantProfileReferenceModel",
      "type": "object"
    }
  },
  "$id": "https://openrae.github.io/rae/schemas/semantic-invariants/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Published shape for RAES semantic-invariant annotations.",
  "properties": {
    "invariant_entry_schema": {
      "const": "#/$defs/RaesSemanticInvariantEntryModel",
      "title": "Invariant Entry Schema",
      "type": "string"
    },
    "invariants": {
      "items": {
        "$ref": "#/$defs/RaesSemanticInvariantEntryModel"
      },
      "title": "Invariants",
      "type": "array"
    },
    "keyword": {
      "const": "x-raes-invariants",
      "title": "Keyword",
      "type": "string"
    },
    "profile_id": {
      "const": "raes-semantic-invariants-v1",
      "title": "Profile Id",
      "type": "string"
    },
    "profile_reference_schema": {
      "const": "#/$defs/RaesSemanticInvariantProfileReferenceModel",
      "title": "Profile Reference Schema",
      "type": "string"
    },
    "schema_version": {
      "const": "raes-semantic-invariants/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "uri": {
      "const": "https://openrae.github.io/rae/schemas/semantic-invariants/v1",
      "title": "Uri",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "profile_id",
    "uri",
    "keyword",
    "invariant_entry_schema",
    "profile_reference_schema",
    "invariants"
  ],
  "title": "RaesSemanticInvariantProfileModel",
  "type": "object"
}
