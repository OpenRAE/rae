{
  "$defs": {
    "EffectiveObservationDemand": {
      "additionalProperties": false,
      "allOf": [
        {
          "properties": {
            "collection": {
              "enum": [
                "disable",
                "require"
              ]
            },
            "export": {
              "enum": [
                "disable",
                "require"
              ]
            },
            "mode": {
              "not": {
                "const": "inherit"
              }
            },
            "retention": {
              "enum": [
                "disable",
                "require"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "none"
              }
            }
          },
          "then": {
            "properties": {
              "collection": {
                "const": "disable"
              },
              "export": {
                "const": "disable"
              },
              "retention": {
                "const": "disable"
              },
              "selectors": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "selected",
                  "exhaustive"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "selectors": {
                "minItems": 1
              }
            },
            "required": [
              "selectors"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "exhaustive"
              }
            }
          },
          "then": {
            "properties": {
              "selectors": {
                "items": {
                  "properties": {
                    "coverage_profile": {
                      "type": "string"
                    },
                    "max_items": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "coverage_profile",
                    "max_items"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "retention": {
                    "const": "require"
                  }
                }
              },
              {
                "properties": {
                  "export": {
                    "const": "require"
                  }
                }
              }
            ]
          },
          "then": {
            "properties": {
              "collection": {
                "const": "require"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "operational-only"
              }
            }
          },
          "then": {
            "properties": {
              "export": {
                "const": "disable"
              },
              "purpose": {
                "const": "operational"
              },
              "retention": {
                "const": "disable"
              }
            }
          }
        }
      ],
      "description": "Normalized configuration-bound demand at one semantic scope.",
      "properties": {
        "basis": {
          "$ref": "#/$defs/ObservationBasis"
        },
        "collection": {
          "$ref": "#/$defs/ObservationLifecycleDecision"
        },
        "export": {
          "$ref": "#/$defs/ObservationLifecycleDecision"
        },
        "integrity": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Integrity"
        },
        "mode": {
          "$ref": "#/$defs/ObservationDemandMode"
        },
        "origins": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "maxProperties": 16,
          "title": "Origins",
          "type": "object"
        },
        "prohibited_stages": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObservationLifecycleStage"
          },
          "maxItems": 3,
          "title": "Prohibited Stages",
          "type": "array"
        },
        "purpose": {
          "$ref": "#/$defs/ObservationPurpose"
        },
        "redaction": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Redaction"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "retention": {
          "$ref": "#/$defs/ObservationLifecycleDecision"
        },
        "scope": {
          "maxLength": 4096,
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
          "title": "Scope",
          "type": "string"
        },
        "selectors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObservationSelector"
          },
          "maxItems": 256,
          "title": "Selectors",
          "type": "array"
        }
      },
      "required": [
        "scope",
        "purpose",
        "mode",
        "collection",
        "retention",
        "export",
        "basis"
      ],
      "title": "EffectiveObservationDemand",
      "type": "object"
    },
    "ObservationBasis": {
      "description": "Truthful basis requested for a reportable value.",
      "enum": [
        "backend-selected",
        "observed",
        "independently-verified",
        "operational"
      ],
      "title": "ObservationBasis",
      "type": "string"
    },
    "ObservationDemandMode": {
      "description": "Selection posture at a named semantic scope.",
      "enum": [
        "inherit",
        "none",
        "operational-only",
        "selected",
        "exhaustive"
      ],
      "title": "ObservationDemandMode",
      "type": "string"
    },
    "ObservationLifecycleDecision": {
      "description": "One local lifecycle preference or monotone prohibition.",
      "enum": [
        "inherit",
        "forbid",
        "disable",
        "require"
      ],
      "title": "ObservationLifecycleDecision",
      "type": "string"
    },
    "ObservationLifecycleStage": {
      "description": "Independently governed data-lifecycle stages.",
      "enum": [
        "collection",
        "retention",
        "export"
      ],
      "title": "ObservationLifecycleStage",
      "type": "string"
    },
    "ObservationPurpose": {
      "description": "Authority plane for requested data use.",
      "enum": [
        "experimental",
        "realization-description",
        "operational"
      ],
      "title": "ObservationPurpose",
      "type": "string"
    },
    "ObservationSelector": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "coverage_profile": {
                "not": {
                  "type": "null"
                }
              }
            },
            "required": [
              "coverage_profile"
            ]
          },
          "then": {
            "properties": {
              "max_items": {
                "not": {
                  "type": "null"
                }
              }
            },
            "required": [
              "max_items"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "max_items": {
                "not": {
                  "type": "null"
                }
              }
            },
            "required": [
              "max_items"
            ]
          },
          "then": {
            "properties": {
              "coverage_profile": {
                "not": {
                  "type": "null"
                }
              }
            },
            "required": [
              "coverage_profile"
            ]
          }
        }
      ],
      "description": "Bounded selector over a semantic scope and one data surface.",
      "properties": {
        "component_refs": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 256,
          "title": "Component Refs",
          "type": "array"
        },
        "coverage_profile": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage Profile"
        },
        "data_kind": {
          "enum": [
            "field",
            "stream",
            "artifact"
          ],
          "title": "Data Kind",
          "type": "string"
        },
        "excluded_scopes": {
          "default": [],
          "items": {
            "maxLength": 4096,
            "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Excluded Scopes",
          "type": "array"
        },
        "max_items": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Items"
        },
        "names": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Names",
          "type": "array"
        },
        "semantic_scope": {
          "maxLength": 4096,
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
          "title": "Semantic Scope",
          "type": "string"
        },
        "window_refs": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 256,
          "title": "Window Refs",
          "type": "array"
        }
      },
      "required": [
        "semantic_scope",
        "data_kind",
        "names"
      ],
      "title": "ObservationSelector",
      "type": "object"
    },
    "PlanOperationModel": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "address": {
          "allOf": [
            {
              "pattern": "^evaluation\\."
            }
          ],
          "maxLength": 2048,
          "minLength": 3,
          "not": {
            "pattern": "[^a-z0-9_.-]"
          },
          "pattern": "^(?:[a-z0-9][a-z0-9_-]{0,63}|__private)(?:\\.(?:[a-z0-9][a-z0-9_-]{0,63}|__private))+$",
          "title": "Address",
          "type": "string"
        },
        "ordering_dependencies": {
          "items": {
            "maxLength": 2048,
            "minLength": 3,
            "not": {
              "pattern": "[^a-z0-9_.-]"
            },
            "pattern": "^(?:[a-z0-9][a-z0-9_-]{0,63}|__private)(?:\\.(?:[a-z0-9][a-z0-9_-]{0,63}|__private))+$",
            "type": "string"
          },
          "title": "Ordering Dependencies",
          "type": "array"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "refresh_dependencies": {
          "items": {
            "maxLength": 2048,
            "minLength": 3,
            "not": {
              "pattern": "[^a-z0-9_.-]"
            },
            "pattern": "^(?:[a-z0-9][a-z0-9_-]{0,63}|__private)(?:\\.(?:[a-z0-9][a-z0-9_-]{0,63}|__private))+$",
            "type": "string"
          },
          "title": "Refresh Dependencies",
          "type": "array"
        },
        "resource_type": {
          "enum": [
            "assertion",
            "condition-binding",
            "objective",
            "proposition"
          ],
          "title": "Resource Type",
          "type": "string"
        }
      },
      "required": [
        "action",
        "address",
        "resource_type"
      ],
      "title": "PlanOperationModel",
      "type": "object"
    }
  },
  "$id": "https://openrae.github.io/rae/schemas/evaluation-plan-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "diagnostics": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "observation_demands": {
      "items": {
        "$ref": "#/$defs/EffectiveObservationDemand"
      },
      "title": "Observation Demands",
      "type": "array"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/PlanOperationModel"
      },
      "title": "Operations",
      "type": "array"
    },
    "startup_order": {
      "items": {
        "maxLength": 2048,
        "minLength": 3,
        "not": {
          "pattern": "[^a-z0-9_.-]"
        },
        "pattern": "^(?:[a-z0-9][a-z0-9_-]{0,63}|__private)(?:\\.(?:[a-z0-9][a-z0-9_-]{0,63}|__private))+$",
        "type": "string"
      },
      "title": "Startup Order",
      "type": "array"
    }
  },
  "title": "EvaluationPlanModel",
  "type": "object"
}
