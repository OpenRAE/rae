  "$id": "https://openrae.github.io/rae/schemas/plan-realization-profiles-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Public values and immutable definitions, not executable support claims.\n\nBindings are an explicit publication-safe programmatic input. Credentials,\nsecret material, opaque exchange and observation claims have no host here.\nSource/trust provenance remains distinct from selected value provenance.",
