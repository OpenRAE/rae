      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Definitions",
      "type": "array"
    }
  },
  "required": [
    "definitions",
    "bindings",
    "constraints"
  ],
  "title": "PlanProfileAuthority",
  "type": "object"
