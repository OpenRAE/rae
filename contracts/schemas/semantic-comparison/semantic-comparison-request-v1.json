{
  "$defs": {
    "ComparisonLimitsModel": {
      "additionalProperties": false,
      "properties": {
        "max_dependency_edges": {
          "default": 8192,
          "maximum": 8192,
          "minimum": 0,
          "title": "Max Dependency Edges",
          "type": "integer"
        },
        "max_diagnostics": {
          "default": 64,
          "maximum": 64,
          "minimum": 0,
          "title": "Max Diagnostics",
          "type": "integer"
        },
        "max_path_depth": {
          "default": 8,
          "maximum": 32,
          "minimum": 0,
          "title": "Max Path Depth",
          "type": "integer"
        },
        "max_paths": {
          "default": 1024,
          "maximum": 4096,
          "minimum": 0,
          "title": "Max Paths",
          "type": "integer"
        },
        "max_subjects": {
          "default": 4096,
          "maximum": 4096,
          "minimum": 1,
          "title": "Max Subjects",
          "type": "integer"
        }
      },
      "title": "ComparisonLimitsModel",
      "type": "object"
    },
    "EvidenceSpecificationCoordinateModel": {
      "additionalProperties": false,
      "properties": {
        "artifact_kind": {
          "const": "evidence-specification",
          "default": "evidence-specification",
          "title": "Artifact Kind",
          "type": "string"
        },
        "canonical_digest": {
          "minLength": 1,
          "pattern": "^(?:sha256:[A-Fa-f0-9]{64}|sha384:[A-Fa-f0-9]{96}|sha512:[A-Fa-f0-9]{128}|blake3:[A-Fa-f0-9]{64})$",
          "title": "Canonical Digest",
          "type": "string"
        },
        "canonical_identity": {
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Canonical Identity",
          "type": "string"
        },
        "canonicalization_profile": {
          "maxLength": 128,
          "pattern": "^[a-z0-9-]+/v[1-9][0-9]*$",
          "title": "Canonicalization Profile",
          "type": "string"
        },
        "capture_spec_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Capture Spec Id",
          "type": "string"
        },
        "exact_representation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactRepresentationModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lifecycle_phase": {
          "const": "portable-contract",
          "default": "portable-contract",
          "title": "Lifecycle Phase",
          "type": "string"
        },
        "schema_version": {
          "const": "experiment-capture-spec/v1",
          "default": "experiment-capture-spec/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "spec_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Spec Version",
          "type": "string"
        }
      },
      "required": [
        "canonical_identity",
        "canonicalization_profile",
        "canonical_digest",
        "capture_spec_id",
        "spec_version"
      ],
      "title": "EvidenceSpecificationCoordinateModel",
      "type": "object"
    },
    "ExactRepresentationModel": {
      "additionalProperties": false,
      "description": "Digest-only evidence for one exact representation, never a host path.",
      "properties": {
        "byte_digest": {
          "minLength": 1,
          "pattern": "^(?:sha256:[A-Fa-f0-9]{64}|sha384:[A-Fa-f0-9]{96}|sha512:[A-Fa-f0-9]{128}|blake3:[A-Fa-f0-9]{64})$",
          "title": "Byte Digest",
          "type": "string"
        },
        "media_type": {
          "enum": [
            "application/json",
            "application/yaml"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "profile": {
          "enum": [
            "utf8-json/v1",
            "utf8-yaml/v1"
          ],
          "title": "Profile",
          "type": "string"
        }
      },
      "required": [
        "profile",
        "media_type",
        "byte_digest"
      ],
      "title": "ExactRepresentationModel",
      "type": "object"
    },
