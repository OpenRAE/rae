{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:raes:tooling:actions-policy:v1",
  "title": "RAES GitHub Actions source policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_revision", "policy_refs", "actions", "local_workflows"],
  "properties": {
    "schema_version": {"const": "raes-development-actions-policy/v1"},
    "policy_revision": {"type": "string", "format": "date"},
    "policy_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "commit", "owner_roles", "trust_root_refs"],
        "properties": {
          "action": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_./-]+$"},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "owner_roles": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "trust_root_refs": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "local_workflows": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^\\./\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$"}
    }
  }
}
