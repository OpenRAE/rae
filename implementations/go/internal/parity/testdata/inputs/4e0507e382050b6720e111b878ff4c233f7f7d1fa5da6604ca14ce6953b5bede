name: observability-plane-conformance
nodes:
  monitor:
    type: compute
    os: linux
    os_distribution: ubuntu
    os_version: "24.04"
    source: exact-monitor-image
    resources: {ram: 1 gib, cpu: 1}
    services:
      - name: http
        port: 80
        protocol: tcp
    runtime:
      service_listeners:
        - service_listener_id: telemetry
          service: http
          address: 0.0.0.0
          port: 80
          protocol: tcp
          address_family: ipv4
          scope: wildcard
evidence_requirements:
  listener-events:
    source_refs: [nodes.monitor.runtime.service_listeners.telemetry]
    scope_refs: [nodes.monitor]
    window: run
    channel: api_response
    sensitivity: plain
    redaction: redact_sensitive
    integrity: checksum
    retention: not_retained
    loss_disclosure: required
    observation_demand:
      rule_id: listener-events
      scope: /nodes/monitor
      purpose: experimental
      mode: selected
      selector:
        semantic_scope: /nodes/monitor
        data_kind: stream
        names: [listener-events]
      collection: require
      retention: disable
      export: disable
      redaction: redact-sensitive
      integrity: checksum
